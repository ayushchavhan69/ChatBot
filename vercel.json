{
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/image/analyze", "destination": "/api/image/analyze" },
    { "source": "/api/status", "destination": "/api/status" },
    { "source": "/api/history/clear", "destination": "/api/history/clear" },
    { "source": "/api/history", "destination": "/api/history" },
    { "source": "/api/user", "destination": "/api/user" },
    { "source": "/", "destination": "/stitch_ui_ux_design_replica/code.html" },
    { "source": "/app.js", "destination": "/stitch_ui_ux_design_replica/app.js" },
    { "source": "/screen.png", "destination": "/stitch_ui_ux_design_replica/screen.png" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
